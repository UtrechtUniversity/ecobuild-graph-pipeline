POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
SS_API_KEY=
SCOPUS_API_KEY=
# Optional: only needed for abstract/full-author access outside your
# institution's IP range. Check with your library.
SCOPUS_INSTTOKEN=
MODEL_NAME=
NEO4J_PASSWORD=

# Read-only connection to the metastudy DS->ES knowledge graph (a separate,
# externally-hosted Neo4j instance — not the local `neo4j` service above).
META_NEO4J_URI=
META_NEO4J_USER=
META_NEO4J_PASSWORD=
META_NEO4J_DATABASE=

# Optional: route api-backend's outbound PDF downloads through a proxy, e.g.
# when the direct egress IP gets 403'd by a publisher's bot protection.
# Leave blank to fetch directly. NO_PROXY keeps internal docker-compose
# service calls (document-db, knowledge-extraction, crawler) off the proxy.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=document-db,knowledge-extraction,crawler,scopus-crawler,localhost,127.0.0.1

# `make deploy` only. Path this app is served under, behind the existing
# ecobuild-caddy-1 reverse proxy already running on the deploy host (see
# orchestration/Caddyfile.snippet) — blank both for a bare-domain/no-prefix deploy.
BASE_PATH=/ecobuild-autolit
API_BASE=/ecobuild-autolit/api

