# One Caddy instance, one domain, two applications:
#
# - The root path serves the Dream Building Recommender (its own web UI, its
#   own API, and its own knowledge extractor) via the existing catch-all
#   reverse_proxy to {$WEB_HOST}:{$WEB_PORT} below.
# - /ecobuild-autolit serves Paper Crawler and Analytics, a separate
#   application with its own frontend and its own API, added as the two
#   handle_path blocks below. Caddy evaluates handle_path/handle before a
#   bare reverse_proxy regardless of file order, so these take priority over
#   the root catch-all without disturbing anything about how the Dream
#   Building Recommender is served.
#
# One-time setup so this Caddy instance can resolve Paper Crawler and
# Analytics' `frontend`/`api-backend` containers by name instead of
# publishing them to the host:
#   docker network create ecobuild-edge
# ...then add `ecobuild-edge` to this Caddy container's own compose service
# (Paper Crawler and Analytics' frontend/api-backend already join it, see
# orchestration/docker-compose.yml).
#
# If this proxy strips the /ecobuild-autolit prefix before forwarding instead
# of passing it through intact, drop the prefix from both handle_path
# matchers below (and from BASE_PATH/API_BASE in orchestration/.env).
{
    email {$CADDY_EMAIL}
}

{$DOMAIN} {
    handle_path /ecobuild-autolit/api/* {
        reverse_proxy api-backend:8000
    }

    handle_path /ecobuild-autolit/* {
        reverse_proxy frontend:80
    }

    reverse_proxy {$WEB_HOST}:{$WEB_PORT}
}
